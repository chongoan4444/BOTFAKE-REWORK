{
  "manifest_version": 3,
  "name": "BOTFAKE STABLE",
  "version": "1.92.18",
  "description": "Bản ổn định: gửi hàng loạt trong tab Pancake. Không nhớ/lọc chat lỗi, có công tắc phím Tab, log cuối gọn.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://pages.fm/*",
    "https://pancake.vn/*",
    "https://pancake.ph/*",
    "https://pancake.id/*",
    "https://pancake.in/*",
    "https://pancake.biz/*",
    "https://socialos.vip/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "action": {
    "default_title": "BOTFAKE LITE",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pancake.vn/*",
        "https://*.pancake.vn/*",
        "https://pages.fm/*",
        "https://*.pages.fm/*",
        "https://pancake.ph/*",
        "https://pancake.id/*",
        "https://pancake.in/*",
        "https://pancake.biz/*",
        "https://socialos.vip/*"
      ],
      "js": [
        "scripts/pancake-send-stable.user.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pancake.vn/*",
        "https://*.pancake.vn/*",
        "https://pages.fm/*",
        "https://*.pages.fm/*",
        "https://pancake.ph/*",
        "https://pancake.id/*",
        "https://pancake.in/*",
        "https://pancake.biz/*",
        "https://socialos.vip/*"
      ],
      "js": [
        "extension/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "extension/overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
